{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RIGHT Checklist Schema",
    "description": "A schema for RIGHT checklist data.",
    "type": "object",
    "properties": {
        "checklist_type": {
            "type": "string",
            "const": "RIGHT"
        },
        "title": {
            "type": "string"
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "section": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    }
                },
                "required": ["section", "id", "description", "type"]
            }
        }
    },
    "required": ["checklist_type", "title", "items"]
}

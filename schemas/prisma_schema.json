{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://www.equator-network.org/schemas/prisma_schema.json",
    "title": "PRISMA 2020 flow diagram schema",
    "description": "A schema for generating PRISMA 2020 flow diagrams.",
    "type": "object",
    "properties": {
        "diagram_type": {
            "description": "The type of diagram to generate.",
            "type": "string",
            "enum": ["PRISMA", "PRISMA_2020_UPDATED"]
        },
        "previous_studies": {
            "description": "Number of studies included in the previous version of the review.",
            "type": "integer",
            "minimum": 0
        },
        "new_records_identified": {
            "description": "Number of new records identified from databases.",
            "type": "integer",
            "minimum": 0
        },
        "new_records_after_duplicates_removed": {
            "description": "Number of new records after duplicates removed.",
            "type": "integer",
            "minimum": 0
        },
        "new_records_screened": {
            "description": "Number of new records screened.",
            "type": "integer",
            "minimum": 0
        },
        "new_records_excluded": {
            "description": "Number of new records excluded.",
            "type": "integer",
            "minimum": 0
        },
        "new_full_text_articles_assessed": {
            "description": "Number of new full-text articles assessed for eligibility.",
            "type": "integer",
            "minimum": 0
        },
        "new_full_text_articles_excluded": {
            "description": "Number of new full-text articles excluded, with reasons.",
            "type": "integer",
            "minimum": 0
        },
        "new_studies_included": {
            "description": "Number of new studies included in the synthesis.",
            "type": "integer",
            "minimum": 0
        },
        "total_studies_included": {
            "description": "Total number of studies included in the synthesis.",
            "type": "integer",
            "minimum": 0
        }
    },
    "if": {
        "properties": { "diagram_type": { "const": "PRISMA" } }
    },
    "then": {
        "required": [
            "diagram_type",
            "records_identified",
            "records_after_duplicates_removed",
            "records_screened",
            "records_excluded",
            "full_text_articles_assessed",
            "full_text_articles_excluded",
            "studies_included"
        ]
    },
    "else": {
        "required": [
            "diagram_type",
            "previous_studies",
            "new_records_identified",
            "new_records_after_duplicates_removed",
            "new_records_screened",
            "new_records_excluded",
            "new_full_text_articles_assessed",
            "new_full_text_articles_excluded",
            "new_studies_included",
            "total_studies_included"
        ]
    },
    "definitions": {
        "style": {
            "type": "object",
            "properties": {
                "box_color": {
                    "type": "string",
                    "description": "The background color of the boxes."
                },
                "font_color": {
                    "type": "string",
                    "description": "The color of the text in the boxes."
                },
                "font_name": {
                    "type": "string",
                    "description": "The name of the font to use for the text."
                },
                "font_size": {
                    "type": "string",
                    "description": "The size of the font to use for the text."
                },
                "arrow_color": {
                    "type": "string",
                    "description": "The color of the arrows."
                }
            }
        }
    },
    "properties": {
        "style": {
            "$ref": "#/definitions/style"
        }
    }
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://www.equator-network.org/schemas/prisma_schema.json",
    "title": "PRISMA 2020 flow diagram schema",
    "description": "A schema for generating PRISMA 2020 flow diagrams.",
    "type": "object",
    "properties": {
        "diagram_type": {
            "description": "The type of diagram to generate.",
            "type": "string",
            "enum": ["PRISMA"]
        },
        "records_identified": {
            "description": "Number of records identified from databases.",
            "type": "integer",
            "minimum": 0
        },
        "records_after_duplicates_removed": {
            "description": "Number of records after duplicates removed.",
            "type": "integer",
            "minimum": 0
        },
        "records_screened": {
            "description": "Number of records screened.",
            "type": "integer",
            "minimum": 0
        },
        "records_excluded": {
            "description": "Number of records excluded.",
            "type": "integer",
            "minimum": 0
        },
        "full_text_articles_assessed": {
            "description": "Number of full-text articles assessed for eligibility.",
            "type": "integer",
            "minimum": 0
        },
        "full_text_articles_excluded": {
            "description": "Number of full-text articles excluded, with reasons.",
            "type": "integer",
            "minimum": 0
        },
        "studies_included": {
            "description": "Number of studies included in the synthesis.",
            "type": "integer",
            "minimum": 0
        }
    },
    "required": [
        "diagram_type",
        "records_identified",
        "records_after_duplicates_removed",
        "records_screened",
        "records_excluded",
        "full_text_articles_assessed",
        "full_text_articles_excluded",
        "studies_included"
    ],
    "definitions": {
        "style": {
            "type": "object",
            "properties": {
                "box_color": {
                    "type": "string",
                    "description": "The background color of the boxes."
                },
                "font_color": {
                    "type": "string",
                    "description": "The color of the text in the boxes."
                },
                "font_name": {
                    "type": "string",
                    "description": "The name of the font to use for the text."
                },
                "font_size": {
                    "type": "string",
                    "description": "The size of the font to use for the text."
                },
                "arrow_color": {
                    "type": "string",
                    "description": "The color of the arrows."
                }
            }
        }
    },
    "properties": {
        "style": {
            "$ref": "#/definitions/style"
        }
    }
}

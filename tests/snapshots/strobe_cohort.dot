// STROBE 2007 Flow Diagram
digraph {
	node [shape=box]
	subgraph cluster_exposed {
		label="Exposed Group"
		A [label="Potentially eligible (n=500)"]
		B [label="Assessed for eligibility (n=400)"]
		C [label="Excluded (n=100)
Did not meet inclusion criteria (n=75)
Declined to participate (n=25)"]
		D [label="Included in study (n=300)"]
		E [label="Lost to follow-up (n=50)
Unable to contact (n=30)
Withdrew consent (n=20)"]
		F [label="Analysed (n=250)"]
		A -> B
		B -> C
		B -> D
		D -> E
		D -> F
	}
	subgraph cluster_unexposed {
		label="Unexposed Group"
		G [label="Potentially eligible (n=500)"]
		H [label="Assessed for eligibility (n=400)"]
		I [label="Excluded (n=100)
Did not meet inclusion criteria (n=75)
Declined to participate (n=25)"]
		J [label="Included in study (n=300)"]
		K [label="Lost to follow-up (n=50)
Unable to contact (n=30)
Withdrew consent (n=20)"]
		L [label="Analysed (n=250)"]
		G -> H
		H -> I
		H -> J
		J -> K
		J -> L
	}
}
